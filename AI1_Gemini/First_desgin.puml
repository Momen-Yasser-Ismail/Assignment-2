@startuml
skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE

class Screen {
  - string outputBuffer
  + void print(uint8_t value)
  + void clear()
  + string getOutput() const
}

class Memory {
  - uint8_t cells[256]
  + void write(uint8_t address, uint8_t value)
  + uint8_t read(uint8_t address) const
  + void clear()
  + const uint8_t* getRawMemory() const
}

class RegisterFile {
  - uint8_t registers[16]
  + void write(uint8_t index, uint8_t value)
  + uint8_t read(uint8_t index) const
  + void clear()
}

class ALU {
  + uint8_t addInt(uint8_t a, uint8_t b) const
  + uint8_t addFloat(uint8_t a, uint8_t b) const
  + uint8_t bitwiseOr(uint8_t a, uint8_t b) const
  + uint8_t bitwiseAnd(uint8_t a, uint8_t b) const
  + uint8_t bitwiseXor(uint8_t a, uint8_t b) const
  + uint8_t rotateRight(uint8_t value, int times) const
}

class Instruction {
  - uint8_t opcode
  - uint8_t r
  - uint8_t s
  - uint8_t t
  - uint8_t xy
  - bool valid
  + static Instruction parse(uint16_t rawBytes)
  + bool isValid() const
  + uint8_t getOpcode() const
  + uint8_t getR() const
  + uint8_t getS() const
  + uint8_t getT() const
  + uint8_t getXY() const
}

class CPU {
  - uint16_t programCounter
  - uint16_t instructionRegister
  - RegisterFile registerFile
  - ALU alu
  - bool halted
  + void fetch(Memory& memory)
  + Instruction decode() const
  + void execute(Instruction instr, Memory& memory, Screen& screen)
  + void step(Memory& memory, Screen& screen)
  + void reset(uint16_t startAddress)
  + bool isHalted() const
  + uint16_t getPC() const
  + uint16_t getIR() const
  + uint8_t getRegister(uint8_t index) const
  + void setRegister(uint8_t index, uint8_t value)
}

class Machine {
  - Memory memory
  - Screen screen
  - CPU cpu
  + bool loadProgram(const string& filename, uint16_t startAddress)
  + void runAll()
  + void runStep()
  + void reset(uint16_t startAddress)
  + void overwriteRegister(uint8_t index, uint8_t value)
  + void overwriteMemory(uint8_t address, uint8_t value)
  + bool isHalted() const
  + void displayState() const
  + string getScreenOutput() const
}

class UI {
  - Machine machine
  + void start()
  - void showMenu()
  - void handleLoadProgram()
  - void handleManualOverride()
  - void handleRun()
  - void displayMemoryTable() const
  - void displayRegisters() const
}

Machine *-- Memory
Machine *-- Screen
Machine *-- CPU
CPU *-- RegisterFile
CPU *-- ALU
UI --> Machine
CPU ..> Instruction : decodes/uses

@enduml